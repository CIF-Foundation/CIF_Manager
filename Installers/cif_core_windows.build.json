{
  "_comment": "Build configuration for the Windows NSIS installer. Edit when new source files must be copied from src/.",
  "_comment_paths": "source: full path from repository root. destination: full path under Installers/Windows/staging/resource/ (CIF/ layout).",
  "_comment_usage": "Applied automatically by Installers/Windows/build_nsis.bat via apply_ipk_build_config.py.",
  "description": "Maps repository source files into the Windows installer resource tree at build time.",
  "resource_template": "Installers/Windows/resource",
  "_comment_resource_template": "Static installer template checked into git (Windows configs, examples, plugin metadata, etc.).",
  "staging_directory": "Installers/Windows/staging/resource",
  "_comment_staging_directory": "Temporary build tree. Created during each build and listed in .gitignore.",
  "copies": [
    { "_comment": "Canonical gRPC protos and license files from src/protos" },
    {
      "source": "src/protos/cif_channel_core.proto",
      "destination": "CIF/protos/cif_channel_core.proto"
    },
    {
      "source": "src/protos/cif_common.proto",
      "destination": "CIF/protos/cif_common.proto"
    },
    {
      "source": "src/protos/cif_management_common.proto",
      "destination": "CIF/protos/cif_management_common.proto"
    },
    {
