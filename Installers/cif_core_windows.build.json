    },
    {
      "source": "src/protos/cif_plugin_loader.proto",
      "destination": "CIF/protos/cif_plugin_loader.proto"
    },
    {
      "source": "src/protos/LICENSE",
      "destination": "CIF/protos/LICENSE"
    },
    {
      "source": "src/protos/README.md",
      "destination": "CIF/protos/README.md"
    },

