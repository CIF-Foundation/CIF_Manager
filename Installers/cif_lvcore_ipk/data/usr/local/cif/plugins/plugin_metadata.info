[L2ENET_Writer_NIXNET_Plugin.2.0.0.lvlibp]
type = "L2ENET_Writer_NIXNET_Plugin"
description = "Write Layer 2 Ethernet frames to an NI XNET interface.  Frames can be filtered (white list) using layer 2 and some IPV4 fields.  If no filter is configured all frames will be output.  Data from FIFO is expected in format defined by TCPDump linktype Ethernet.  \0A\0AThe output clock source is configurable.  By default output timing is aligned to system time but the plugin can be configured to use an external clock for output timing.  \0A\0AFrame output timing can be controlled in software or using the XNET HW timing support.  \0A\0AWhen timing is controlled by software, the output is set by T_Out in the FIFO.  If multiple frames are present in one FIFO element they are all burst out at the specified T_Out.  When software timing is used multiple writers can link to the same XNET interface supporting concurrent outputs.\0A\0AWhen timing is controlled by hardware, the output is set by the timestamps in the individual ethernet frame headers and the T_Out in the FIFO is ignored.  The first output will be software timed and then subsequent outputs will occur based on the frame timestamps.  \0AWhen hardware timing is used an additional filter can be provided in Berkeley Packet Filter (BPF) format.  This filter will be applied in the XNET driver.  The driver supports a subset of classic BPF.  From testing, "OR" statements should be represented with a "," separator (instead of an OR).  AND statements are not supported.  Due to the limitations and potential for BPF support to change with changes to NI driver code, the BPF filter is presented as an advanced option and advanced configuration.  When used, explicit testing should be performed to validate filter operation.  "
history = "Version 1.1.0.0 - Added support for Linux Desktop and Windows\0AVersion 1.1.1.0 - Windows fix for Timed Loop priority and mute of 9006 warning.  \0AVersion 1.1.2.0 - Windows Log timestamp update to use wall clock time\0AVersion 1.1.3.0 - Standard support for mute late cycle warnings on Linux and Windows.  Mute gRCP client timeout in UI.\0AVersion 1.1.4.0 - Flexible tag linking support added.\0DVersion 2.0.0.0 - Update to gRPC core library."
author = "DOME Automation"

[Modbus_Client_Plugin.2.0.0.lvlibp]
type = "Modbus_Client_Plugin"
description = "Exchange data with Modbus devices (clients).  This supports TCP, Serial, and RTU communication layers.  It also provides conversion functions to manipulate register data to/from Modbus into data types other than U16.  It supports conversion to/from 16, 32, 64 bit signed and unsigned integers and to/from float32 and double formats.  \0A\0AIt assumes all registers on the device follow the modbus standard (big endian U16) but supports flexibility for endian format of words for multi-register data elements.  \0A\0AConfiguration uses a CSV format to specify channels, directions, and conversions and expects CSV with the following format:\0A\0AChannel Name:  Should contain name using letters, numbers, -, and _\0A\0AStart Address (0 base).  The starting (lowest) address for the modbus registers.  Data that uses more than 16 bits (eg U32 or Doubles) will automatically read/write multiple addresses.  Register values are 0 based (some devices document registers starting at 1). The value should be in hex format.  A hex prefix of 0x is optional.  \0A\0AModbus Function:  There is no default value and if no match is found it will provide a warning.  Valid functions are:\0A- R_Coil (Read Coil)\0A- R_HoldReg (Read Holding Register)\0A- R_DI (Read Discrete Input)\0A- R_InReg (Read Input Register)\0A- W_Coil (Write Coil)\0A- W_HoldReg (Write Holding Register)\0A- W_DI (Write Discrete Input, server/slave only)\0A- W_InReg (Write Input Register, server/slave only)\0A\0AData type: This is only used for registers and is ignored for coil or discrete input operations.  For register R/W the data will be reformated to/from this type. The data type will also control how many registers are read/written.  Valid options are:\0A- U16 (default)\0A- I16\0A- U32\0A- I32\0A- U64\0A- I64\0A- Float32\0A- Double\0A\0AEndian Word:  This is only used for data types that span multiple modbus registers.  Modbus specifies data in a register is big endian but does not specify how values that span multiple registers are managed.  This defines the endian of the registers (at a word level).  Valid options are:\0A- BE_Word (Big Endian Word, default)\0A- LE_Word (Little Endian Word)"
history = "Version 2.0.0.0 - Update to gRPC core library."
author = "DOME Automation"

