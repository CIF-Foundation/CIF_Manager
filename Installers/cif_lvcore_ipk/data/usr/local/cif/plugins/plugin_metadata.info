[Wireshark_Capture_Server_Plugin.2.0.0.lvlibp]
type = "Wireshark_Capture_Server_Plugin"
description = "This will provide remote access to a program such as Wireshark or Tshark to data in PCAP format from a FIFO.  It creates a TCP server supporting the remote packet capture protocol.  This allows local or remote wireshark programs to be used for real-time monitoring and display of stream data as well as remote logging.  This creates a TCP server.  \0ATo connect from Wireshark use a command such as "C:\\Program Files\\Wireshark\\Wireshark.exe" -k -i TCP@127.0.0.1:18999  or "C:\\Program Files\\Wireshark\\Wireshark.exe" -k -i TCP@127.0.0.1:18999 -w "C:\\path\\to\\logfile.pcapng"\0A\0ANote the data in the FIFO must already be in PCAP format.  "
history = "Version 2.0.0.0 - Update to gRPC core library."
author = "DOME Automation"

