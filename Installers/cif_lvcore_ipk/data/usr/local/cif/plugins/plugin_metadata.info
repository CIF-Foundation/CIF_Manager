[Publish_Telemetry_Plugin.2.0.0.lvlibp]
type = "Publish_Telemetry_Plugin"
description = "Reads CIPC data elements and publishes as packed telemetry data in PCAP format.  This custom PCAP format can be parsed according to a schema.  The plugin creates the JSON schema and provides via a gRPC service.  This schema can be used by Wireshark to interpret telemetry data directly.  \0A\0AThe plugin is configured with a CSV list of CIPC channel names to read.  It will read the latest value of all channels and can read any CIPC data including clusters, and fixed size arrays.  If the CIPC data includes a prepended length this will also be included in the packed data stream.  \0A\0AWhen the plugin transitions to run it will create an output U8 FIFO that can be passed to a local logger or to a TCP streamer plugin for async logging or remote display.  On restart it will check if the channels to read has changed.  On change a new FIFO, with a new name, will be created. "
history = "Version 2.0.0.0 - Update to gRPC core library."
author = "DOME Automation"

