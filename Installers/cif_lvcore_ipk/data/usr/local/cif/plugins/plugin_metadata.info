[Battery_Capacity_Plugin.2.0.0.lvlibp]
type = "Battery_Capacity_Plugin"
description = "The plugin will ingest voltage and current waveforms and calculate the capacity of a battery under test. This supports up to 4 channels and is designed to work with the RM26999 or similar with simultaneous sampled channels.  \0A\0AThe input is a DAQ FIFO where the first half the channels are voltage and the second half are current.  For instance 4 channels are voltage 0-3 and the next 4 channels are current 0-3.  \0A\0AIt will output a waveform of the computed power.  The output power sample size must match the input voltage waveform size.  The default size is 100k samples per channel.  Changing the sample size should be done before starting the plugin or linking other plugins to the power output FIFO.   \0A\0AIt will also track the cumulative charge in coulomb and the cumulative energy in Joules.  The inital values can be set.    "
history = "Version 1.0.0.1 - First Build\0AVersion 1.1.0.0 - Support for selection of timed loop structure and running priority control outside of timed loop. \0AVersion 1.1.1.0 - Windows fix for Timed Loop priority and mute of 9006 warning.  \0AVersion 1.1.2.0 - Windows fix for Timed Loop priority and mute of 9006 warning.  \0AVersion 1.1.3.0 - Windows Log timestamp update to use wall clock time\0AVersion 1.1.4.0 - Standard support for mute late cycle warnings on Linux and Windows.  Mute gRCP client timeout in UI.\0AVersion 1.1.5.0 - Flexible tag linking support added.\0DVersion 2.0.0.0 - Update to gRPC core library."
author = "DOME Automation"

