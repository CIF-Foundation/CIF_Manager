{
  "_comment": "Build configuration for cif_lvcore_ipk. Edit this file when new source files must be copied into the package.",
  "_comment_paths": "source: full path from repository root. destination: full path from ipk package root (inside cif_lvcore_ipk/).",
  "_comment_usage": "Run Installers/build_cif_lvcore_ipk.bat (Windows) or bash Installers/build_cif_lvcore_ipk.sh (WSL/Linux).",
  "description": "Maps repository source files into the cif_lvcore_ipk package at build time. Paths are relative to the repository root.",
  "ipk_template": "Installers/cif_lvcore_ipk",
  "_comment_ipk_template": "Static package template checked into git (binaries, conf, control scripts, etc.).",
  "staging_directory": "Installers/staging/cif_lvcore_ipk",
  "_comment_staging_directory": "Temporary build tree. Created during each build and listed in .gitignore.",
  "output_directory": "Installers/output",
  "_comment_output_directory": "Final .ipk file is written here as cif-lvcore.<version>.ipk.",
  "copies": [
    { "_comment": "Canonical gRPC protos and license files from src/protos" },
    {
      "source": "src/protos/cif_channel_core.proto",
      "destination": "data/usr/local/cif/protos/cif_channel_core.proto"
    },
